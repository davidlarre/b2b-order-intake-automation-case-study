# Copia este fichero como .env y rellena tus valores. .env no se versiona.

# Clave gratuita de Google AI Studio (aistudio.google.com → Get API key)
GEMINI_API_KEY=

# Supabase local
SUPABASE_URL=http://127.0.0.1:54321
# Cadena de conexión a la base de datos local: es el valor DB_URL de `supabase status -o env`
SUPABASE_DB_URL=
