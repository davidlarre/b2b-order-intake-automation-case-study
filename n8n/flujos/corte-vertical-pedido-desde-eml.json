    {
      "parameters": {
        "jsCode": "const correo = $('Leer .eml').first().json;\nconst configuracion = correo.configuracion;\n\n// Los nombres son los parámetros de api.registrar_extraccion.\nconst cuerpo = {\n  caso: $('Registrar correo').first().json.caso,\n  configuracion,\n};\n\n// Interruptor de la IA: en \"solo reglas\" Gemini no se ha ejecutado y no hay nada que leer.\nif (configuracion !== 'solo_reglas') {\n  const respuesta = $('Extraer con Gemini').first().json;\n  // Busca la respuesta del modelo por su tipo: antes puede venir un \"thought\" (el razonamiento).\n  const salida = (respuesta.steps ?? []).find(s => s.type === 'model_output');\n  const texto = salida?.content?.find(c => c.type === 'text')?.text;\n  if (!texto) {\n    throw new Error('Gemini no devolvió un model_output con texto');\n  }\n  let extraccion;\n  try {\n    extraccion = JSON.parse(texto);\n  } catch (e) {\n    throw new Error('La respuesta de Gemini no es JSON válido: ' + e.message);\n  }\n  const uso = respuesta.usage ?? {};\n  Object.assign(cuerpo, {\n    extraccion_ia: extraccion,\n    prompt_hash: $('Leer prompt activo').first().json.hash,\n    modelo: respuesta.model,\n    tokens_entrada: uso.total_input_tokens ?? null,\n    // El razonamiento también se factura como salida.\n    tokens_salida: (uso.total_output_tokens ?? 0) + (uso.total_thought_tokens ?? 0),\n  });\n}\n\n// Interruptor del determinista: en \"solo IA\" su lectura no se envía.\nif (configuracion !== 'solo_ia') {\n  const determinista = $('Extractor determinista').first().json;\n  Object.assign(cuerpo, {\n    extraccion_determinista: { lineas: determinista.lineas },\n    version_determinista: determinista.version,\n  });\n}\n\nreturn [{ json: cuerpo }];"
      },
