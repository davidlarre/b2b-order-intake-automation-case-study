    {
      "parameters": {
        "jsCode": "const { simpleParser } = require('mailparser');\nconst { preprocesarAdjuntos } = require('orvalle-extractor');\n\n// El .eml llega del Webhook como binario en la propiedad \"data\".\nconst buffer = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst correo = await simpleParser(buffer);\n\n// Excel a texto, imágenes ignoradas y el resto \"no soportado\" (04, sección 6.2).\nconst adjuntos = await preprocesarAdjuntos(correo.attachments);\n\nconst autenticacion = correo.headers.get('authentication-results');\n\nreturn [{\n  json: {\n    message_id: correo.messageId ?? null,\n    remitente: correo.from?.value?.[0]?.address?.toLowerCase() ?? null,\n    asunto: correo.subject ?? null,\n    autenticacion: Array.isArray(autenticacion) ? autenticacion.join('; ') : (autenticacion ?? null),\n    hora_recepcion: correo.date ? correo.date.toISOString() : null,\n    // Lo que lee la IA: el cuerpo y, si hay Excel, su texto.\n    texto: [correo.text ?? '', adjuntos.texto].filter(t => t.trim() !== '').join('\\n\\n'),\n    // Las filas de cada Excel, para el extractor determinista (paso 4).\n    excels: adjuntos.excels,\n    // Los adjuntos que no se pueden leer: si hay alguno, el caso irá a M02 (paso 3c.2).\n    no_soportados: adjuntos.noSoportados,\n    adjuntos_ignorados: adjuntos.ignorados,\n  },\n}];"
      },
