    {
      "parameters": {
        "jsCode": "const respuesta = $input.first().json;\n\n// Busca la respuesta del modelo por su tipo: antes puede venir un \"thought\" (el razonamiento).\nconst salida = (respuesta.steps ?? []).find(s => s.type === 'model_output');\nconst texto = salida?.content?.find(c => c.type === 'text')?.text;\nif (!texto) {\n  throw new Error('Gemini no devolvió un model_output con texto');\n}\n\nlet extraccion;\ntry {\n  extraccion = JSON.parse(texto);\n} catch (e) {\n  throw new Error('La respuesta de Gemini no es JSON válido: ' + e.message);\n}\n\nconst uso = respuesta.usage ?? {};\n\nreturn [{\n  json: {\n    caso: $('Registrar correo').first().json.caso,\n    extraccion,\n    modelo: respuesta.model,\n    prompt_hash: $('Leer prompt activo').first().json.hash,\n    configuracion: 'solo_ia',\n    tokens_entrada: uso.total_input_tokens ?? null,\n    // El razonamiento también se factura como salida: se suma para que el coste por correo sea real.\n    tokens_salida: (uso.total_output_tokens ?? 0) + (uso.total_thought_tokens ?? 0),\n  },\n}];"
      },
