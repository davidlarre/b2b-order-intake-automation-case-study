    {
      "parameters": {
        "jsCode": "const CONFIGURACIONES = ['solo_reglas', 'solo_ia', 'hibrido'];\nconst configuracion = $('Webhook').first().json.query?.configuracion ?? 'hibrido';\nif (!CONFIGURACIONES.includes(configuracion)) {\n  throw new Error(`Configuración desconocida: ${configuracion}`);\n}\n\nconst crypto = require('crypto');\nconst { simpleParser } = require('mailparser');\nconst { preprocesarAdjuntos } = require('orvalle-extractor');\n\nconst buffer = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst correo = await simpleParser(buffer);\nconst adjuntos = await preprocesarAdjuntos(correo.attachments);\nconst autenticacion = correo.headers.get('authentication-results');\n\n// Ruta del .eml en Storage: fecha del correo + huella del Message-ID (nada personal en el nombre).\nconst fecha = correo.date ? correo.date.toISOString().slice(0, 10) : 'sin-fecha';\nconst huella = crypto.createHash('sha256').update(correo.messageId ?? buffer).digest('hex');\n\nreturn [{\n  json: {\n    message_id: correo.messageId ?? null,\n    remitente: correo.from?.value?.[0]?.address?.toLowerCase() ?? null,\n    asunto: correo.subject ?? null,\n    autenticacion: Array.isArray(autenticacion) ? autenticacion.join('; ') : (autenticacion ?? null),\n    hora_recepcion: correo.date ? correo.date.toISOString() : null,\n    configuracion,\n    cuerpo: correo.text ?? '',\n    texto: [correo.text ?? '', adjuntos.texto].filter(t => t.trim() !== '').join('\\n\\n'),\n    excels: adjuntos.excels,\n    no_soportados: adjuntos.noSoportados,\n    adjuntos_ignorados: adjuntos.ignorados,\n    ruta_eml: `${fecha}/${huella}.eml`,\n    remitente_nombre: correo.from?.value?.[0]?.name || null,\n    adjuntos: (correo.attachments ?? []).map(a => ({ nombre: a.filename ?? null, tipo: a.contentType ?? null, tamano: a.size ?? null })),\n  },\n  binary: { data: $input.first().binary.data },\n}];"
      },
